{
  "name": "sshya",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "version": "0.8.0",
  "description": "CLI and MCP server for managing SSH connections with aliases, pooled connections, and LLM-friendly JSON output",
  "license": "MIT",
  "author": "ceneka",
  "keywords": [
    "ssh",
    "cli",
    "ssh-config",
    "ssh-aliases",
    "connection-manager",
    "fzf",
    "fuzzy-search",
    "bun",
    "terminal",
    "devops",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "agents",
    "controlmaster"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ceneka/sshya.git"
  },
  "homepage": "https://github.com/Ceneka/sshya#readme",
  "bugs": {
    "url": "https://github.com/Ceneka/sshya/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fuse.js": "^7.5.0",
    "inquirer": "^12.11.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "scripts": {
    "start": "bun run index.ts",
    "mcp": "bun run index.ts mcp",
    "build": "bun run scripts/build.ts",
    "bench:startup": "bun run scripts/bench-startup.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "bin": {
    "sshya": "dist/index.js",
    "s": "dist/s.js"
  }
}
